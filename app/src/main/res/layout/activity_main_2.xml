
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#1a1a1a" android:padding="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="140dp" android:layout_height="42dp" android:src="@drawable/logo_kevin" android:contentDescription="Kevin logo"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" JAM JUM EDITION" android:textColor="#00E5FF" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginStart="6dp"/>
        <TextView android:id="@+id/midiStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="USB: -- BT: --" android:textColor="#FFCC00" android:gravity="end" android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:text="KNOB BANK" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:textSize="7sp" android:layout_margin="3dp"/>
        <Button android:id="@+id/btnPadBank" android:text="PAD BANK" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:textSize="7sp" android:layout_margin="3dp" android:backgroundTint="#00FF88"/>
        <Button android:text="FULL LEVEL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:textSize="7sp" android:layout_margin="3dp"/>
        <Button android:text="16 LEVEL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:textSize="7sp" android:layout_margin="3dp"/>
        <Button android:text="SHIFT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:textSize="7sp" android:layout_margin="3dp"/>
        <Button android:id="@+id/btnNoteRepeat" android:text="NOTE REPEAT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:textSize="7sp" android:layout_margin="3dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="90dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:text="DIV" android:textColor="#00E5FF" android:background="#00E5FF20" android:gravity="center" android:layout_width="60dp" android:layout_height="18dp" android:textSize="9sp"/>
            <View android:layout_width="54dp" android:layout_height="54dp" android:background="#222" android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>
            <TextView android:text="SWING" android:textColor="#00E5FF" android:gravity="center" android:layout_width="60dp" android:layout_height="18dp" android:textSize="9sp"/>
            <View android:layout_width="54dp" android:layout_height="54dp" android:background="#222" android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>
            <TextView android:text="GATE" android:textColor="#00E5FF" android:gravity="center" android:layout_width="60dp" android:layout_height="18dp" android:textSize="9sp"/>
            <View android:layout_width="54dp" android:layout_height="54dp" android:background="#222" android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>
            <TextView android:text="TEMPO" android:textColor="#00E5FF" android:gravity="center" android:layout_width="60dp" android:layout_height="18dp" android:textSize="9sp"/>
            <View android:layout_width="54dp" android:layout_height="54dp" android:background="#222" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <GridLayout android:id="@+id/padGrid" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:columnCount="4" android:rowCount="4" android:useDefaultMargins="true"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
        <Button android:text="&lt;" android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="3dp"/>
        <Button android:id="@+id/btnBT" android:text="BT" android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="3dp" android:backgroundTint="#00E5FF"/>
        <Button android:text="&gt;" android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="3dp"/>
        <Button android:id="@+id/btnPlay" android:text="▶" android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="3dp"/>
        <Button android:id="@+id/btnStop" android:text="■" android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="3dp"/>
        <Button android:id="@+id/btnRec" android:text="●" android:textColor="#FF0000" android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="3dp"/>
    </LinearLayout>
</LinearLayout>
